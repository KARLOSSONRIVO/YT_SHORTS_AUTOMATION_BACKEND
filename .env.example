NODE_ENV=development
PORT=5001
API_PREFIX=/api
MONGODB_URI=mongodb://localhost:27017/youtube_shorts_automation
REDIS_URL=redis://localhost:6379
PYTHON_WORKER_BASE_URL=http://localhost:8000
